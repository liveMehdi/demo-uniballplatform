    "setup:societies": "tsx src/scripts/setupSocieties.ts",
    "dev:worker": "tsx watch src/worker.ts",
    "start:worker": "node dist/worker.js",
    "test:email": "tsx src/scripts/testEmail.ts",
    "email:check": "node dist/scripts/checkEmail.js",
    "email:status": "node dist/scripts/emailStatus.js"
  },
  "keywords": [],
